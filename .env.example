# ─── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Get both URLs from: https://console.neon.tech → your project → Connection Details
#
# DATABASE_URL  → use the "Pooled connection" string (ends with ?pgbouncer=true or -pooler hostname)
# DIRECT_URL    → use the "Direct connection" string (no pooler, used only by `prisma migrate`)

DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# ─── Session ───────────────────────────────────────────────────────────────────
# Must be at least 32 random characters
SESSION_SECRET="your-super-secret-session-key-at-least-32-chars-long-here"

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Choose "anthropic" or "openai"
LLM_PROVIDER="anthropic"

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-6"

# OpenAI (GPT-4) — https://platform.openai.com
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o"
